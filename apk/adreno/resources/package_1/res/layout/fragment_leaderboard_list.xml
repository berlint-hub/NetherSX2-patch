<?xml version='1.0' encoding='utf-8' ?>
<RelativeLayout android:layout_width="fill_parent"
                android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
  <androidx.constraintlayout.widget.ConstraintLayout android:id="@id/navigation_header_container"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
    <RelativeLayout android:padding="8.0dp"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toStartOf="@id/close"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
      <ImageView android:id="@id/icon"
                 android:layout_width="48.0dp"
                 android:layout_height="wrap_content"
                 android:layout_alignBottom="@id/summary"
                 android:layout_alignParentTop="true"
                 android:foregroundGravity="center_vertical"
                 android:layout_alignParentStart="true" />
      <TextView android:textAppearance="?attr/textAppearanceHeadline5"
                android:id="@id/title"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="0.0dp"
                android:layout_height="wrap_content"
                android:text="Game Title"
                android:layout_alignParentTop="true"
                android:layout_marginStart="10.0dp"
                android:layout_toEndOf="@id/icon"
                android:layout_alignParentEnd="true" />
      <TextView android:textAppearance="?attr/textAppearanceCaption"
                android:id="@id/summary"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="0.0dp"
                android:layout_height="wrap_content"
                android:text="You have unlocked %d of %d achievements, earning %d of %d possible points."
                android:layout_below="@id/title"
                android:layout_marginStart="10.0dp"
                android:layout_toEndOf="@id/icon"
                android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <ImageButton android:id="@id/close"
                 android:background="?android:attr/selectableItemBackground"
                 android:layout_width="48.0dp"
                 android:layout_height="55.0dp"
                 android:src="@drawable/ic_baseline_close_24"
                 android:contentDescription="Close"
                 android:layout_marginEnd="5.0dp"
                 app:layout_constraintEnd_toEndOf="parent"
                 app:layout_constraintTop_toTopOf="parent"
                 app:tint="?android:attr/textColorPrimary" />
  </androidx.constraintlayout.widget.ConstraintLayout>
  <androidx.recyclerview.widget.RecyclerView android:id="@id/recyclerView"
                        android:scrollbars="vertical"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_below="@id/navigation_header_container"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true" />
  <include layout="@layout/include_progress_overlay" />
</RelativeLayout>